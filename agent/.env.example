# Base URL of the Arc Blockscout explorer (https only).
ARC_EXPLORER_URL=https://explorer.arc.io

# Chain reported in the output. Defaults are Arc mainnet (Arc / 5042).
# For the testnet explorer use: ARC_CHAIN_NAME=Arc Testnet and ARC_CHAIN_ID=5042002
ARC_CHAIN_NAME=Arc
ARC_CHAIN_ID=5042

# Optional Blockscout API key. Leave empty to send no key.
ARC_EXPLORER_API_KEY=
